{
  "name": "poolup_backend",
  "version": "1.0.0",
  "description": "#Local Environment Setup 1. Install nodeJS by following installation guides from https://nodejs.org/en/download/ 2. Install all used packages & dependencies using:     `npm install` 3. Install mongoDB by following installation guides from: Mac: https://treehouse.github.io/installation-guides/mac/mongo-mac.html Windows: https://docs.mongodb.com/manual/tutorial/install-mongodb-on-windows/  - this is different form the npm package listed in package.json, which is the driver that connects the DB to the nodeJS app.",
  "main": "index.js",
  "scripts": {
    "docker-dev": "env-cmd -r ./config/.env-cmdrc -e base_config,development-docker nodemon src/server.js",
    "docker-init_db": "env-cmd -r ./config/.env-cmdrc -e base_config,development-docker node init_db.js",
    "docker-test": "env-cmd -r ./config/.env-cmdrc -e development,testing-docker jest --watch --runInBand",
    "start": "env-cmd -r ./config/.env-cmdrc -e base_config,production node src/server.js",
    "dev": "env-cmd -r ./config/.env-cmdrc -e base_config,development nodemon src/server.js",
    "setup": "node ./setup/setup.js",
    "init_db": "env-cmd -r ./config/.env-cmdrc -e base_config,development node ./setup/init_db.js",
    "test": "env-cmd -r ./config/.env-cmdrc -e base_config,test jest --watch --runInBand",
    "ci_test": "jest --verbose --runInBand --ci"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/jestDefaultTimeout.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aws-sdk": "^2.486.0",
    "bluebird": "^3.5.5",
    "body-parser": "^1.19.0",
    "chalk": "^2.4.2",
    "connect-mongo": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^8.0.0",
    "email-addresses": "^3.1.0",
    "email-templates": "^7.0.4",
    "env-cmd": "^10.0.1",
    "express": "^4.17.1",
    "express-session": "^1.17.0",
    "file-type": "^12.0.0",
    "fs": "0.0.1-security",
    "handlebars": "^4.7.6",
    "isemail": "^3.2.0",
    "jest": "^24.9.0",
    "js-sha256": "^0.9.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.13",
    "mongoose": "^5.7.5",
    "multiparty": "^4.2.1",
    "node-schedule": "^1.3.2",
    "nodemailer": "^6.4.6",
    "nodemon": "^1.19.1",
    "parse-domain": "^2.3.4",
    "sha256": "^0.2.0",
    "sinon": "^9.0.1",
    "stripe": "^7.14.0",
    "supertest": "^4.0.2"
  }
}
