----- ENV CONFIGURATION
MODE=<Either "STAGING" or "DEPLOY">
PORT=<PORT NUMBER HERE>
MONGODB_URL=<ENTER MONGODB_URL HERE>
PRODUCTION_DOMAIN_URL=<ENTER DOMAIN_URL HERE>

----- AWS CREDENTIALS
S3_BUCKET=<ENTER BUCKET NAME HERE>
