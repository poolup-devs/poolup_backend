AWS_SECRET_ACCESS_KEY=<ENTER SECRET ACCESS KEY HERE>

----- 3rd PARTY CREDENTIALS
SENDGRID_API_KEY=<ENTER API KEY HERE>

----- APPLICATION KEYS
JWT_SECRET_KEY=<ENTER SECRET KEY HERE>
JWT_EMAIL_KEY=<ENTER SECRET KEY HERE>

----- NOTIFICATION REDIRECT PATHS
MY_RIDES_PATH="/rider/my-rides"
MY_DRIVES_PATH="/driver/my-drives" 